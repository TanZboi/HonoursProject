!tests/fixtures/
!tests/fixtures/**

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/

# --- IDE / OS ---
.idea/
.vscode/
.DS_Store
